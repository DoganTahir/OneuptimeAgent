# Export mode: console (default) | oneuptime
# - console: print spans locally (no network)
# - oneuptime: send OTLP/HTTP traces; app reports collector SUCCESS/FAILURE
#   UI visibility in OneUptime is a separate manual check after SUCCESS
OTEL_EXPORT_MODE=console

# OneUptime OpenTelemetry ingestion (used when OTEL_EXPORT_MODE=oneuptime)
# Base URL form: https://<host>/otlp
# App appends /v1/traces once → final path must be .../otlp/v1/traces
# Do not include /v1/traces twice; do not put the token in the URL
ONEUPTIME_OTLP_ENDPOINT=https://oneuptime.com/otlp
ONEUPTIME_INGESTION_TOKEN=your-ingestion-token-here

# OpenTelemetry service identity
OTEL_SERVICE_NAME=oneuptime-agent-poc

# LLM provider (used in later phases)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your-llm-api-key-here
LLM_MODEL=gpt-4o-mini
